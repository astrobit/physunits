                masssolar, massjupiter, massearth, massmoon, radiussolar,
                radiusjupiter, radiusearth, radiusmoon, luminositysolar }
              { \exp_args:NNe \clist_gput_right:Nn \g__physunits_disabled_clist { \tl_to_str:n {##1} } }
          }
    },
    disable-astro-mass-radii .default:n = {true},
%    \end{macrocode}
% \changes{v1.3.0}{2026/11/24}{Added the \texttt{disable} option.}
% Key \texttt{disable}: a list of command names that are not to be
% defined. Names are given without the backslash (in \cs{usepackage} options
% a control sequence would be expanded); a leading backslash is removed if
% present. Each is stored as a string, and compared as a string when the
% commands are defined.
%    \begin{macrocode}
    disable .code = {
        \__physunits_load_only:n {disable}
        \clist_map_inline:nn {#1}
          {
            \str_set:Nx \l__physunits_name_str { \tl_to_str:n {##1} }
            \str_remove_all:Nn \l__physunits_name_str { ~ }
            \str_if_eq:eeT { \str_head:N \l__physunits_name_str } { \c_backslash_str }
              { \str_set:Nx \l__physunits_name_str { \str_tail:N \l__physunits_name_str } }
            \clist_gput_right:NV \g__physunits_disabled_clist \l__physunits_name_str
          }
    },
%    \end{macrocode}
% \changes{v1.3.0}{2026/11/24}{Added the \texttt{skip-defined} option.}
% Key \texttt{skip-defined}.
%    \begin{macrocode}
    skip-defined .code = {
        \__physunits_load_only:n {skip-defined}
        \str_if_eq:nnTF {#1} {false}
          { \bool_gset_false:N \g__physunits_skip_defined_bool }
          { \bool_gset_true:N \g__physunits_skip_defined_bool }
    },
    skip-defined .default:n = {true},
%    \end{macrocode}
% \begin{macro}{\physunitssetup}
