% \begin{macro}{\physunits@ell,\ohm@unit,\physunits@angstrom}
% \changes{v1.3.0}{2026/11/24}{Fixed the \texttt{ell} value of the \texttt{liter} option, which printed nothing under Xe\LaTeX\ and Lua\LaTeX.}
% \changes{v1.3.0}{2026/11/24}{Fixed the ohm units, which printed nothing under Xe\LaTeX\ and Lua\LaTeX, and the misplaced ring on the angstrom.}
% Symbols that need care under \textsf{unicode-math}, where \cs{mathrm}
% switches to the text font. The text font has no $\ell$ or math $\Omega$, so
% these are taken upright from the math font with \cs{symup}. The angstrom uses
% the text font's precomposed \AA\ (U+00C5), because \cs{mathring} places the
% ring badly there.
%    \begin{macrocode}
\ifPDFTeX
  \DeclareRobustCommand{\physunits@ell}{\ell}
  \DeclareRobustCommand{\ohm@unit}{\Omega}
  \DeclareRobustCommand{\physunits@angstrom}{\mathring{A}}
\else
  \DeclareRobustCommand{\physunits@ell}{\symup{\ell}}
  \DeclareRobustCommand{\ohm@unit}{\symup{\Omega}}
  \DeclareRobustCommand{\physunits@angstrom}{\Uchar"00C5}
\fi
%    \end{macrocode}
% \end{macro}
