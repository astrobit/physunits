% \section{Syntax}\label{sec:prefixes}
% \changes{v1.3.0}{2026/11/16}{Replaced the Bases and Exponent section with a
%   description of the prefix, exponent and separator arguments.}
%
% Most unit macros take up to three optional arguments:
% \begin{center}
% \meta{unit macro}\oarg{prefix}\oarg{exponent}\oarg{separator}
% \end{center}
% The \meta{prefix} is set in roman type in front of the unit symbol; use one
% of the prefix macros of Section~\ref{sec:prefixmacros} or plain letters.
% The \meta{exponent} is set as a superscript, and an empty exponent prints
% nothing. The \meta{separator} replaces the space before the unit; an empty
% separator removes it. For example:
% \begin{center}
% \begin{tabular}{ll}
% \verb|3\meter|             & 3\meter \\
% \verb|3\meter[\kilo]|      & 3\meter[\kilo] \\
% \verb|3\meter[\kilo][2]|   & 3\meter[\kilo][2] \\
% \verb|3\meter[][-1]|       & 3\meter[][-1] \\
% \verb|3\meter[\micro][3][]|& 3\meter[\micro][3][] \\
% \end{tabular}
% \end{center}
%
% Units that are not used with SI prefixes (most non-SI units, and units such
% as \cs{kg} whose symbol already contains a prefix) take only the last two
% arguments: \meta{unit macro}\oarg{exponent}\oarg{separator}. Each entry in
% Section~\ref{sec:units} shows which form applies.
%
% \textbf{Caution:} because the arguments are optional and come after the
% macro, a unit directly followed by a bracket treats that bracket as an
% argument, even across a space. Write \verb|3\kg{} [see note]| rather than
% \verb|3\kg [see note]|.
%
% \DescribeMacro{\punit}\DescribeMacro{\punitDeg}\DescribeMacro{\punitVar}
% For units that the package does not provide, use \\
% \cs{punit}\marg{symbol}\oarg{prefix}\oarg{exponent}\oarg{separator}.
% \cs{punitDeg} does the same with a leading degree sign, and \cs{punitVar}
% does not force the symbol to roman type (used for symbols such as
% $M_\odot$). For example, \verb|\punit{Mx}[\kilo]| gives \punit{Mx}[\kilo].
%
% \DescribeMacro{\pThinSpace}\DescribeMacro{\pMediumSpace}
% \DescribeMacro{\pThickSpace}\DescribeMacro{\pFullSpace}
% The spaces selected by the \texttt{unit-space} option are \cs{pThinSpace}
% (\verb|\,|), \cs{pMediumSpace} (\verb|\:|), \cs{pThickSpace} (\verb|\;|) and
% \cs{pFullSpace} (a non-breaking space). They can be given as a
% \meta{separator}.
%
% \section{Naming convention}
% \changes{v1.3.0}{2026/11/16}{Added lower-case macro variants.}
%
% Each unit has a macro named after the unit in lower case, e.g.\
% \cs{coulomb}, and usually a title-case synonym, e.g.\ \cs{Coulomb}. Many
% also have a short form matching the symbol, such as \cs{m}, \cs{s} and \cs{N}. Where the natural name clashes with an existing
% command, a different name is used; these cases are noted with each unit.
% Before v1.3.0 only the title-case and symbol forms existed.
%
