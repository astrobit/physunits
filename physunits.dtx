% \subsection{Unit constructors}
% \begin{macro}{\physunits@mhoprefix}
% The expl3 helpers \verb|\__physunits_exp:n| and \verb|\__physunits_prefix:n| add an exponent or prefix only when the argument is not blank; \cs{physunits@mhoprefix} adds the mho gap after a non-blank prefix.
%    \begin{macrocode}
\cs_new:Npn \__physunits_exp:n #1 { \tl_if_blank:nF {#1} { ^{#1} } }
\cs_new:Npn \__physunits_prefix:n #1 { \tl_if_blank:nF {#1} { \mathrm{#1} } }
\cs_new:Npn \physunits@mhoprefix #1 { \tl_if_blank:nF {#1} { #1 \physunits@mho@gap } }
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\physunits@unit,\physunits@degreeUnit,\physunits@variableUnit}
% The three internal constructors: roman symbol, degree symbol, and a symbol that is not forced to roman. The last optional argument is the separator; its default is the current unit space.
%    \begin{macrocode}
\NewDocumentCommand\physunits@unit{mO{}O{}O{\physunits@units@separator}}{\ensuremath{#4\mathrm{#2#1}\__physunits_exp:n{#3}}}
\NewDocumentCommand\physunits@degreeUnit{mO{}O{}O{\physunits@degree@separator}}{\ensuremath{#4{}^{\circ}\mathrm{#2#1}\__physunits_exp:n{#3}}}
\NewDocumentCommand\physunits@variableUnit{mO{}O{}O{\physunits@units@separator}}{\ensuremath{#4\__physunits_prefix:n{#2}#1\__physunits_exp:n{#3}}}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\units@separator}
% \changes{v1.3.0}{2026/11/24}{Restored \cs{units@separator} from v1.2 for backward compatibility.}
% \cs{units@separator} was the unit separator in v1.2. It is kept for
% compatibility and gives the current unit space. Redefining it no longer
% changes the space before units; use the \texttt{unit-space} option or the
% \meta{separator} argument instead.
%    \begin{macrocode}
\DeclareRobustCommand\units@separator{\physunits@units@separator}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\punit,\punitDeg,\punitVar}
% \changes{v1.3.0}{2026/11/24}{Added user-level unit constructors.}
%    \begin{macrocode}
\NewDocumentCommand\punit{mO{}O{}O{\physunits@units@separator}}{\physunits@unit{#1}[#2][#3][#4]}
\NewDocumentCommand\punitDeg{mO{}O{}O{\physunits@units@separator}}{\physunits@degreeUnit{#1}[#2][#3][#4]}
\NewDocumentCommand\punitVar{mO{}O{}O{\physunits@units@separator}}{\physunits@variableUnit{#1}[#2][#3][#4]}

\ExplSyntaxOff
%    \end{macrocode}
% \end{macro}
