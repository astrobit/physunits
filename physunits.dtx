% \subsection{Options}
% The options are declared with the kernel \cs{DeclareKeys}, inside an expl3 block. Each choice key defines an internal symbol macro; \texttt{.initial:n} sets the default when the key is not given, and \texttt{.default:n} is the value used when the key is given without a value. Spaces are ignored under \cs{ExplSyntaxOn}, so the warning texts use \verb|~| for spaces.
% \changes{v1.3.0}{2026/11/24}{Added the variables for the \texttt{disable} and \texttt{skip-defined} options.}
% The names of disabled commands, the \texttt{skip-defined} switch, and a
% flag set at the end of the package. Options that decide which commands are
% defined only work while the package is loaded; afterwards they warn.
%    \begin{macrocode}
\ExplSyntaxOn
\clist_new:N \g__physunits_disabled_clist
\clist_new:N \g__physunits_published_clist
\bool_new:N \g__physunits_skip_defined_bool
\bool_new:N \g__physunits_loaded_bool
\str_new:N \l__physunits_name_str
\cs_new_protected:Npn \__physunits_load_only:n #1
  {
    \bool_if:NT \g__physunits_loaded_bool
      { \PackageWarning{physunits}{The~#1~option~only~works~when~the~package~is~loaded.} }
  }
%    \end{macrocode}
%    \begin{macrocode}
\DeclareKeys[physunits]{
%    \end{macrocode}
