% \begin{macro}{\physunits@slantbox,\physunits@foobox}
% \changes{v1.3.0}{2026/11/24}{Added \cs{physunits@slantbox} for an upright micro sign under pdf\TeX.}
% \changes{v1.3.0}{2026/11/24}{Added attribution and license notice for the shear code.}
% The material is boxed, the current point moves past it, and the box is drawn back over that space under a shear matrix. Inside the expl3 block the matrix entries are separated with \verb|~|.
%
% This code is adapted from \cs{slantbox} by Bruno Le Floch,
% \url{https://tex.stackexchange.com/a/63188}, and is used under the LPPL
% with his permission. The attribution lines below begin
% with \verb|%%| so that docstrip copies them into \texttt{physunits.sty}.
%    \begin{macrocode}
%% ----------------------------------------------------------------------
%% \physunits@foobox and \physunits@slantbox
%% Source - https://tex.stackexchange.com/a/63188
%% Posted by Bruno Le Floch, modified by community. See post 'Timeline'
%% for change history
%% Retrieved 2026-11-24. Originally posted under CC BY-SA 3.0; used here
%% under the LPPL with the permission of Bruno Le Floch (2026-11-24).
%% Modified for physunits: renamed \slantbox to \physunits@slantbox and
%% \foobox to \physunits@foobox; defined with \NewDocumentCommand with the
%% material first and the shear as a trailing optional argument; default
%% shear changed from .5 to -0.25; matrix entries separated with ~ for
%% expl3 syntax.
%% ----------------------------------------------------------------------
\newsavebox{\physunits@foobox}
\NewDocumentCommand{\physunits@slantbox}{m O{-0.25}}
{\mbox{%
    \sbox{\physunits@foobox}{#1}%
    \hskip\wd\physunits@foobox
    \pdfsave
    \pdfsetmatrix{1~0~#2~1}%
    \llap{\usebox{\physunits@foobox}}%
    \pdfrestore
}}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\physunits@mho,\physunits@mho@gap,\physunits@usefontmho}
% \changes{v1.3.0}{2026/11/24}{Added mho support with a rotated-Omega fallback.}
% The mho symbol is a rotated $\Omega$ unless \textsf{amssymb} or \textsf{unicode-math} is loaded, in which case the font glyph is used. The font glyph has almost no left side-bearing, so a small gap is added between a prefix and the glyph.
%    \begin{macrocode}
\DeclareRobustCommand{\physunits@mho}{\mbox{\rotatebox[origin=c]{180}{$\Omega$}}}
\DeclareRobustCommand{\physunits@mho@gap}{}
\AtBeginDocument{%
  \IfPackageLoadedTF{amssymb}{\physunits@usefontmho}{%
    \IfPackageLoadedTF{unicode-math}{\physunits@usefontmho}{}}}
\DeclareRobustCommand{\physunits@usefontmho}{%
  \let\physunits@mho\mho
  \DeclareRobustCommand{\physunits@mho@gap}{\mkern2mu}}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\micro@unit}
% The micro sign: sheared italic $\mu$ under pdf\TeX\ in PDF mode, plain $\mu$ in DVI mode, \cs{upmu} otherwise.
%    \begin{macrocode}
\ifPDFTeX\ifpdf\DeclareRobustCommand{\micro@unit}{\physunits@slantbox{\ensuremath{\mu}}}\else\DeclareRobustCommand{\micro@unit}{\mu}\fi\else\DeclareRobustCommand{\micro@unit}{\upmu}\fi
%    \end{macrocode}
% \end{macro}
