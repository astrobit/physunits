\ifPDFTeX\ifpdf\DeclareRobustCommand{\micro@unit}{\physunits@slantbox{\ensuremath{\mu}}}\else\DeclareRobustCommand{\micro@unit}{\mu}\fi\else\DeclareRobustCommand{\micro@unit}{\upmu}\fi
%    \end{macrocode}
% \end{macro}
