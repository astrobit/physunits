%    \begin{macrocode}
    amu .code = {
        \str_case:nnF {#1}
        {
            {u}{\DeclareRobustCommand{\amu@unit}{u}}
            {amu}{\DeclareRobustCommand{\amu@unit}{amu}}
            {Da}{\DeclareRobustCommand{\amu@unit}{Da}}
        }
        {\PackageWarning{physunits}{Unrecognized~option~for~amu.~Option~values~are~u,~amu,~and~Da.}}
    },
    amu .default:n = {amu},
    amu .initial:n = {amu},
%    \end{macrocode}
