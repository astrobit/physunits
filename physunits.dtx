% The prefix macros can be used as the \meta{prefix} argument or on their own.
% Under pdf\TeX\ the micro sign is an upright $\mu$ made by shearing the math
% italic one with a horizontal shear of $-0.25$, which cancels the slant of
% Computer Modern math italic (this needs pdf\TeX\ in PDF mode); with Xe\TeX\ and Lua\TeX\ it is \cs{upmu}.
%
% \begin{center}
% \begin{tabular}{llll}
% \SpecialUsageIndex{\quetta}\cs{quetta} & $\quetta$ & \SpecialUsageIndex{\ronna}\cs{ronna} & $\ronna$ \\
% \SpecialUsageIndex{\yotta}\cs{yotta} & $\yotta$ & \SpecialUsageIndex{\zetta}\cs{zetta} & $\zetta$ \\
% \SpecialUsageIndex{\exa}\cs{exa} & $\exa$ & \SpecialUsageIndex{\peta}\cs{peta} & $\peta$ \\
% \SpecialUsageIndex{\tera}\cs{tera} & $\tera$ & \SpecialUsageIndex{\giga}\cs{giga} & $\giga$ \\
% \SpecialUsageIndex{\hebdo}\cs{hebdo} & $\hebdo$ & \SpecialUsageIndex{\Hebdo}\cs{Hebdo} & $\Hebdo$ \\
% \SpecialUsageIndex{\mega}\cs{mega} & $\mega$ & \SpecialUsageIndex{\kilo}\cs{kilo} & $\kilo$ \\
% \SpecialUsageIndex{\hecto}\cs{hecto} & $\hecto$ & \SpecialUsageIndex{\deci}\cs{deci} & $\deci$ \\
% \SpecialUsageIndex{\deka}\cs{deka} & $\deka$ & \SpecialUsageIndex{\deca}\cs{deca} & $\deca$ \\
% \SpecialUsageIndex{\centi}\cs{centi} & $\centi$ & \SpecialUsageIndex{\milli}\cs{milli} & $\milli$ \\
% \SpecialUsageIndex{\micro}\cs{micro} & $\micro$ & \SpecialUsageIndex{\nano}\cs{nano} & $\nano$ \\
% \SpecialUsageIndex{\pico}\cs{pico} & $\pico$ & \SpecialUsageIndex{\femto}\cs{femto} & $\femto$ \\
% \SpecialUsageIndex{\atto}\cs{atto} & $\atto$ & \SpecialUsageIndex{\zepto}\cs{zepto} & $\zepto$ \\
% \SpecialUsageIndex{\yocto}\cs{yocto} & $\yocto$ & \SpecialUsageIndex{\ronto}\cs{ronto} & $\ronto$ \\
% \SpecialUsageIndex{\quecto}\cs{quecto} & $\quecto$ & \SpecialUsageIndex{\myria}\cs{myria} & $\myria$ \\
% \end{tabular}
