% \SpecialUsageIndex{\deka}\cs{deka} & $\deka$ & \SpecialUsageIndex{\deca}\cs{deca} & $\deca$ \\
% \SpecialUsageIndex{\centi}\cs{centi} & $\centi$ & \SpecialUsageIndex{\milli}\cs{milli} & $\milli$ \\
% \SpecialUsageIndex{\micro}\cs{micro} & $\micro$ & \SpecialUsageIndex{\nano}\cs{nano} & $\nano$ \\
% \SpecialUsageIndex{\pico}\cs{pico} & $\pico$ & \SpecialUsageIndex{\femto}\cs{femto} & $\femto$ \\
